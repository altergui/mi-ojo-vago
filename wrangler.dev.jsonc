{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mi-ojo-vago-dev",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "mi-ojo-vago-dev.guidev.org", "custom_domain": true }
  ],
  // Per-PR preview URLs come from `wrangler versions upload`; stated
  // explicitly (it is also the default) because CI depends on it.
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}
