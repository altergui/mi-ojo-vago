{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mi-ojo-vago",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "mi-ojo-vago.guidev.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
